[node name="Label" type="Label" parent="PauseMenu/Rules/VBoxContainer"]
layout_mode = 2
text = "Players take it in turns to place or move cards into one of three zones
that face off. The game ends when each face off has a valid hand. The
player with the most valid hands wins. A valid hand is either:

  -  Between 25 and 30, inclusive, and higher than the opposing hand, or,
  -  Exactly 5 below the opposing hand.

If the game ends, it will reset after 10 seconds."

